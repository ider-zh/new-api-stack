# =============================================================================
# Example environment file for the New-API stack.
# Copy this to `.env` and fill in real values, then run `docker compose up -d`.
# `.env` is git-ignored — never commit real secrets.
# =============================================================================

# --- PostgreSQL (used by both new-postgres and the SQL_DSN of new-api) --------
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=new-api

# --- Redis connection string consumed by new-api ------------------------------
REDIS_CONN_STRING=redis://new-redis

# --- OpenResty AI gateway tuning (all optional, sensible defaults applied) ----
RPM_CAPACITY=25            # token-bucket capacity (= max burst requests/min)
RPM_WINDOW_SECONDS=60      # window over which RPM_CAPACITY tokens refill
MAX_429_RETRIES=5          # transparent retries on upstream 429 before giving up
RETRY_BACKOFF_SECONDS=1    # base backoff (linear: attempt x base) between retries
GATEWAY_HOST_PORT=30082    # host port the gateway is published on
